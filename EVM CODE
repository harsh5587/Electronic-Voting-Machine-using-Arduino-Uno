| Component     | Pin Name  | Arduino Pin   | Connection Details         |
| ------------- | --------- | ------------- | -------------------------- |
| Push Button 1 | SW1       | A0            | One side → A0, other → GND |
| Push Button 2 | SW2       | A1            | One side → A1, other → GND |
| Push Button 3 | SW3       | A2            | One side → A2, other → GND |
| Push Button 4 | SW4       | A3 (D17)      | One side → A3, other → GND |
| Result Button | SW5       | A4 (D18)      | One side → A4, other → GND |
| LCD RS        | RS        | D11           | Control pin                |
| LCD EN        | EN        | D10           | Control pin                |
| LCD D4        | Data 4    | D9            | Data line                  |
| LCD D5        | Data 5    | D8            | Data line                  |
| LCD D6        | Data 6    | D7            | Data line                  |
| LCD D7        | Data 7    | D6            | Data line                  |
| LCD VSS       | GND       | GND           | Ground                     |
| LCD VDD       | VCC       | 5V            | Power                      |
| LCD RW        | RW        | GND           | Write mode                 |
| LCD VO        | Contrast  | Potentiometer | Middle pin of pot          |
| Potentiometer | Side 1    | 5V            | Contrast control           |
| Potentiometer | Side 2    | GND           | Contrast control           |
| Buzzer (+)    | Buzzer    | D2            | Positive terminal          |
| Buzzer (-)    | GND       | GND           | Ground                     |
| LED 1 (+)     | Indicator | D12           | Via 220Ω resistor          |
| LED 2 (+)     | Indicator | D13           | Via 220Ω resistor          |
| LED (-)       | GND       | GND           | Ground                     |

------------CODE-------------
#include <LiquidCrystal.h>

LiquidCrystal lcd(11,10,9,8,7,6);

#define sw1 A0
#define sw2 A1
#define sw3 A2
#define sw4 17
#define sw5 18
#define buzzer 2

int vote1 = 0;
int vote2 = 0;
int vote3 = 0;
int vote4 = 0;

void setup() {
  pinMode(sw1, INPUT);
  pinMode(sw2, INPUT);
  pinMode(sw3, INPUT);
  pinMode(sw4, INPUT);
  pinMode(sw5, INPUT);

  pinMode(13, OUTPUT);
  pinMode(12, OUTPUT);
  pinMode(buzzer, OUTPUT);

  lcd.begin(16, 2);

  lcd.setCursor(0,0);
  lcd.print(" MCI PROJECT");
  lcd.setCursor(0,1);
  lcd.print(" ROLL NO 32 & 49");
  delay(3000);

  lcd.clear();
  lcd.print(" VOTING MACHINE ");
  lcd.setCursor(0,1);
  lcd.print(" LCD DISPLAY");
  delay(3000);

  // Enable pull-up
  digitalWrite(sw1, HIGH);
  digitalWrite(sw2, HIGH);
  digitalWrite(sw3, HIGH);
  digitalWrite(sw4, HIGH);
  digitalWrite(sw5, HIGH);

  lcd.clear();
  lcd.setCursor(0,0);
  lcd.print("BJP");
  lcd.setCursor(4,0);
  lcd.print("INC");
  lcd.setCursor(8,0);
  lcd.print("AAP");
  lcd.setCursor(12,0);
  lcd.print("OTH");
}

void loop() {

  lcd.setCursor(0,0); lcd.print("BJP");
  lcd.setCursor(1,1); lcd.print(vote1);

  lcd.setCursor(4,0); lcd.print("INC");
  lcd.setCursor(5,1); lcd.print(vote2);

  lcd.setCursor(8,0); lcd.print("AAP");
  lcd.setCursor(9,1); lcd.print(vote3);

  lcd.setCursor(12,0); lcd.print("OTH");
  lcd.setCursor(13,1); lcd.print(vote4);

  if(digitalRead(sw1) == 0) {
    vote1++;
    buzz();
    digitalWrite(12, HIGH);
    while(digitalRead(sw1) == 0);
    digitalWrite(12, LOW);
    delay(1000);
  }

  if(digitalRead(sw2) == 0) {
    vote2++;
    buzz();
    digitalWrite(12, HIGH);
    while(digitalRead(sw2) == 0);
    digitalWrite(12, LOW);
    delay(1000);
  }

  if(digitalRead(sw3) == 0) {
    vote3++;
    buzz();
    digitalWrite(12, HIGH);
    while(digitalRead(sw3) == 0);
    digitalWrite(12, LOW);
    delay(1000);
  }

  if(digitalRead(sw4) == 0) {
    vote4++;
    buzz();
    digitalWrite(12, HIGH);
    while(digitalRead(sw4) == 0);
    digitalWrite(12, LOW);
    delay(1000);
  }
  if(digitalRead(sw5) == 0) {
    digitalWrite(13, HIGH);

    int vote = vote1 + vote2 + vote3 + vote4;

    if(vote) {
      lcd.clear();

      if(vote1 > vote2 && vote1 > vote3 && vote1 > vote4)
        lcd.print("BJP Wins");
      else if(vote2 > vote1 && vote2 > vote3 && vote2 > vote4)
        lcd.print("INC Wins");
      else if(vote3 > vote1 && vote3 > vote2 && vote3 > vote4)
        lcd.print("AAP Wins");
      else if(vote4 > vote1 && vote4 > vote2 && vote4 > vote3)
        lcd.print("OTH Wins");
      else {
        lcd.print(" Tie Up Or ");
        lcd.setCursor(0,1);
        lcd.print(" No Result ");
      }

      delay(5000);
      lcd.clear();
    }
    else {
      lcd.clear();
      lcd.print("No Voting....");
      delay(5000);
      lcd.clear();
    }

    vote1 = vote2 = vote3 = vote4 = 0;

    digitalWrite(12, HIGH);
    digitalWrite(13, LOW);
  }
}
void buzz() {
  digitalWrite(buzzer, HIGH);
  delay(200);
  digitalWrite(buzzer, LOW);
}
